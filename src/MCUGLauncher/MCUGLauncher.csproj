<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MCUGLauncher</AssemblyName>
    <RootNamespace>BlockLaunch</RootNamespace>
    <Version>0.21.0</Version>
    <Product>MCUG Launcher</Product>
    <Title>MCUG Launcher</Title>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <ApplicationIcon>Assets/MCUGLauncher.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/MCUGLogo.png" />
    <ProjectReference Include="../MCUGLauncher.Application/MCUGLauncher.Application.csproj" />
    <ProjectReference Include="../MCUGLauncher.SharedUI/MCUGLauncher.SharedUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Front/**/*.cs;Accounts/**/*.cs;Adapters/**/*.cs;Builders/**/*.cs;Contracts/**/*.cs;Downloads/**/*.cs;Launch/**/*.cs;Resources/**/*.cs;Settings/**/*.cs;Versions/**/*.cs;Brand.cs" />
    <Page Remove="Front/**/*.xaml" />
    <None Remove="Front/**/*" />
    <EmbeddedResource Include="Resources/Notices.txt" LogicalName="BlockLaunch.Resources.Notices.txt" />
  </ItemGroup>
</Project>
