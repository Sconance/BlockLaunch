<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MCUGLauncher</AssemblyName>
    <RootNamespace>MCUGLauncher</RootNamespace>
    <Product>MCUG Launcher</Product>
    <Title>MCUG Launcher</Title>
    <ApplicationIcon>Assets/MCUGLauncher.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MCUGLauncher.Core/MCUGLauncher.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1823.32" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Ui/index.html" LogicalName="MCUGLauncher.Ui.index.html" />
    <EmbeddedResource Include="Ui/styles.css" LogicalName="MCUGLauncher.Ui.styles.css" />
    <EmbeddedResource Include="Ui/install.js" LogicalName="MCUGLauncher.Ui.install.js" />
    <EmbeddedResource Include="Ui/instance-tools.js" LogicalName="MCUGLauncher.Ui.instance-tools.js" />
    <EmbeddedResource Include="Ui/saves.js" LogicalName="MCUGLauncher.Ui.saves.js" />
    <EmbeddedResource Include="Ui/bookmarks.js" LogicalName="MCUGLauncher.Ui.bookmarks.js" />
    <EmbeddedResource Include="Ui/games.js" LogicalName="MCUGLauncher.Ui.games.js" />
    <EmbeddedResource Include="Ui/tasks.js" LogicalName="MCUGLauncher.Ui.tasks.js" />
    <EmbeddedResource Include="Ui/bootstrap.js" LogicalName="MCUGLauncher.Ui.bootstrap.js" />
    <EmbeddedResource Include="Ui/state.js" LogicalName="MCUGLauncher.Ui.state.js" />
    <EmbeddedResource Include="Ui/preview-data.js" LogicalName="MCUGLauncher.Ui.preview-data.js" />
    <EmbeddedResource Include="Ui/graphics.js" LogicalName="MCUGLauncher.Ui.graphics.js" />
    <EmbeddedResource Include="Ui/navigation.js" LogicalName="MCUGLauncher.Ui.navigation.js" />
    <EmbeddedResource Include="Ui/home-page.js" LogicalName="MCUGLauncher.Ui.home-page.js" />
    <EmbeddedResource Include="Ui/community-pages.js" LogicalName="MCUGLauncher.Ui.community-pages.js" />
    <EmbeddedResource Include="Ui/resource-pages.js" LogicalName="MCUGLauncher.Ui.resource-pages.js" />
    <EmbeddedResource Include="Ui/instance-pages.js" LogicalName="MCUGLauncher.Ui.instance-pages.js" />
    <EmbeddedResource Include="Ui/settings-page.js" LogicalName="MCUGLauncher.Ui.settings-page.js" />
    <EmbeddedResource Include="Ui/account-modals.js" LogicalName="MCUGLauncher.Ui.account-modals.js" />
    <EmbeddedResource Include="Ui/app.js" LogicalName="MCUGLauncher.Ui.app.js" />
    <EmbeddedResource Include="Ui/host.js" LogicalName="MCUGLauncher.Ui.host.js" />
    <EmbeddedResource Include="Ui/assets/logo.png" LogicalName="MCUGLauncher.Ui.assets.logo.png" />
    <EmbeddedResource Include="Assets/MCUGLogo.png" LogicalName="Assets.MCUGLogo.png" />
  </ItemGroup>
</Project>



