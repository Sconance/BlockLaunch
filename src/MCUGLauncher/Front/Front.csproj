<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MCUGLauncher.Front</AssemblyName>
    <StartupObject>BlockLaunch.Front.Program</StartupObject>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Version>0.21.0</Version>
    <ApplicationIcon>Assets/MCUGLauncher.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/MCUGLogo.png" />
    <Resource Include="Assets/MCUGLauncher.ico" />
    <ProjectReference Include="../../MCUGLauncher.Application/MCUGLauncher.Application.csproj" />
    <ProjectReference Include="../../MCUGLauncher.SharedUI/MCUGLauncher.SharedUI.csproj" />
  </ItemGroup>
</Project>
