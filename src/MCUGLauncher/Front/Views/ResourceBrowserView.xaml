<UserControl x:Class="BlockLaunch.Front.ResourceBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <DataTemplate x:Key="ResourceCardItem">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition /></Grid.RowDefinitions>
        <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
        <Button x:Name="Favorite" Content="♡" Click="CardFavoriteClick" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="6,2" Margin="5" ToolTip="收藏此资源" />
        <StackPanel Grid.Row="1" Margin="0,5,0,0">
          <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" MaxHeight="14" Margin="0,2" />
          <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="10" TextTrimming="CharacterEllipsis" MaxHeight="14" />
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter TargetName="Favorite" Property="Content" Value="♥" /></DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="ResourceListItem">
      <Grid MinHeight="58">
        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Image Width="40" Height="40" Source="{Binding IconUrl}" Stretch="UniformToFill" />
        <StackPanel Grid.Column="1" Margin="8,0">
          <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="10" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button x:Name="Favorite" Grid.Column="2" Content="♡" Click="CardFavoriteClick" Padding="7,3" ToolTip="收藏此资源" />
      </Grid>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter TargetName="Favorite" Property="Content" Value="♥" /></DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border x:Name="SearchPanel" Style="{StaticResource Card}" Padding="12" CornerRadius="7">
      <StackPanel>
        <DockPanel Margin="0,3,0,12">
          <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
            <CheckBox Content="★ 仅收藏" IsChecked="{Binding FavoritesOnly}" VerticalAlignment="Center" Click="FavoritesClick" />
            <Button Content="清除筛选" Click="ClearFavoritesClick" />
          </WrapPanel>
          <TextBlock x:Name="CategoryMark" Text="✚" FontSize="38" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0" DockPanel.Dock="Left" VerticalAlignment="Center" />
          <StackPanel>
            <TextBlock x:Name="CategoryTitle" Text="模组" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="CategorySubtitle" Text="发现并安装适合当前实例的模组。" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="132" /><ColumnDefinition Width="74" /></Grid.ColumnDefinitions>
          <TextBox x:Name="SearchQuery" Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索名称、作者或描述" KeyDown="SearchKeyDown" MinHeight="34" Margin="0,0,8,0" />
          <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Source}" Margin="0,0,8,0">
            <ComboBoxItem Content="Modrinth" Tag="modrinth" />
            <ComboBoxItem Content="CurseForge（未启用）" Tag="curseforge" />
          </ComboBox>
          <Button Grid.Column="2" Content="搜索" Click="SearchClick" Margin="0" Padding="10,6" />
        </Grid>
        <WrapPanel Margin="0,0,0,8">
          <StackPanel x:Name="ResourceKindField" Width="112" Margin="0,0,8,0">
            <TextBlock Text="资源类型" Style="{StaticResource Caption}" />
            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Kind}" SelectionChanged="KindChanged">
              <ComboBoxItem Content="模组" Tag="mod" />
              <ComboBoxItem Content="资源包" Tag="resourcepack" />
              <ComboBoxItem Content="光影" Tag="shader" />
              <ComboBoxItem Content="数据包" Tag="datapack" />
              <ComboBoxItem Content="整合包" Tag="modpack" />
            </ComboBox>
          </StackPanel>
          <StackPanel Width="112" Margin="0,0,8,0">
            <TextBlock Text="游戏版本" Style="{StaticResource Caption}" FontSize="11" />
            <TextBox Text="{Binding GameVersion, UpdateSourceTrigger=PropertyChanged}" ToolTip="跟随实例 / 全部 / 自行输入版本号" Margin="0" />
          </StackPanel>
          <StackPanel Width="112" Margin="0,0,8,0">
            <TextBlock Text="加载器" Style="{StaticResource Caption}" FontSize="11" />
            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Loader}">
              <ComboBoxItem Content="跟随实例" Tag="跟随实例" />
              <ComboBoxItem Content="全部加载器" Tag="" />
              <ComboBoxItem Content="Fabric" Tag="fabric" /><ComboBoxItem Content="Forge" Tag="forge" />
              <ComboBoxItem Content="NeoForge" Tag="neoforge" /><ComboBoxItem Content="Quilt" Tag="quilt" />
            </ComboBox>
          </StackPanel>
          <StackPanel Width="112" Margin="0,0,8,0">
            <TextBlock Text="发布类型" Style="{StaticResource Caption}" FontSize="11" />
            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Channel}">
              <ComboBoxItem Content="全部类型" Tag="" /><ComboBoxItem Content="正式版" Tag="release" />
              <ComboBoxItem Content="测试版" Tag="beta" /><ComboBoxItem Content="开发版" Tag="alpha" />
            </ComboBox>
          </StackPanel>
          <StackPanel Width="112" Margin="0,0,8,0">
            <TextBlock Text="排序" Style="{StaticResource Caption}" FontSize="11" />
            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Sort}" SelectionChanged="SortChanged">
              <ComboBoxItem Content="相关性" Tag="relevance" />
              <ComboBoxItem Content="下载量" Tag="downloads" />
              <ComboBoxItem Content="最近更新" Tag="updated" />
              <ComboBoxItem Content="收藏优先" Tag="favorites" />
            </ComboBox>
          </StackPanel>
          <Button Content="重置条件" Click="ResetClick" VerticalAlignment="Bottom" Padding="10,6" Margin="0,15,6,0" />
          <Button Content="▦" ToolTip="卡片视图" Click="CardsClick" Width="34" FontSize="18" Padding="3" Margin="0,15,4,0" VerticalAlignment="Bottom" />
          <Button Content="≡" ToolTip="列表视图" Click="ListClick" Width="34" FontSize="18" Padding="3" Margin="0,15,4,0" VerticalAlignment="Bottom" />
        </WrapPanel>
        <TextBlock Text="光影需 Iris / OptiFine 等支持；数据包安装时选择目标存档。CurseForge 接口已预留，未接入在线服务。" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <StackPanel x:Name="SearchStatus" Grid.Row="1" Margin="0,12">
      <ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}" />
      <TextBlock Text="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <Grid Grid.Row="2">
      <ListBox x:Name="Results" ItemsSource="{Binding Items}" SelectionChanged="ProjectChanged" HorizontalContentAlignment="Stretch" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="12,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Image Source="{Binding IconUrl}" Width="48" Height="48" Stretch="Uniform" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Description}" Margin="0,6" TextWrapping="Wrap" MaxHeight="40" />
                <TextBlock Style="{StaticResource Caption}">
                  <Run Text="{Binding Author}" /><Run Text="  ·  " /><Run Text="{Binding Downloads, StringFormat=N0}" /><Run Text=" 次下载" />
                </TextBlock>
                <TextBlock Text="{Binding Tags}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <DockPanel x:Name="PagingPanel" Grid.Row="3" Margin="0,12,0,0">
      <Button Content="取消读取" Click="CancelClick" DockPanel.Dock="Right" />
      <StackPanel Orientation="Horizontal">
        <Button Content="上一页" IsEnabled="{Binding CanPrevious}" Click="PreviousClick" />
        <Button Content="下一页" IsEnabled="{Binding CanNext}" Click="NextClick" />
      </StackPanel>
    </DockPanel>
    <Border x:Name="DetailPanel" Grid.RowSpan="4" Padding="0" Visibility="Collapsed">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top">
          <WrapPanel DockPanel.Dock="Right">
            <Button Content="♡ 收藏" Click="SaveFavoriteClick" />
            <Button Content="取消收藏" Click="RemoveFavoriteClick" />
          </WrapPanel>
          <Button Content="← 返回搜索结果" HorizontalAlignment="Left" Click="BackClick" />
        </DockPanel>
        <Grid x:Name="DetailColumns" Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="0" /></Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,16,0">
          <DockPanel>
            <Image Source="{Binding Selected.IconUrl}" Width="58" Height="58" Margin="0,0,14,0" DockPanel.Dock="Left" />
            <StackPanel>
              <TextBlock Text="{Binding Selected.Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
              <TextBlock Text="{Binding Selected.Meta}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
        <TabControl Background="Transparent" BorderThickness="0" Margin="0,14,0,0">
          <TabItem Header="介绍" Style="{StaticResource ResourceDetailTab}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,12">
                <ItemsControl ItemsSource="{Binding Gallery}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Width="150" Height="92" CornerRadius="7" ClipToBounds="True" Margin="0,0,7,7">
                      <Image Source="{Binding}" Stretch="UniformToFill" />
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Selected.Description}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,16" />
                <TextBlock Text="{Binding ProjectBody}" TextWrapping="Wrap" FontSize="13" LineHeight="21" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="版本" Style="{StaticResource ResourceDetailTab}">
            <StackPanel Margin="0,12">
              <TextBlock Text="{Binding SelectedVersion.Facts}" TextWrapping="Wrap" />
              <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Label" MaxHeight="320" Margin="0,12,0,0" BorderThickness="0" Background="{DynamicResource ThemeSurfaceBrush}" />
            </StackPanel>
          </TabItem>
          <TabItem Header="依赖" Style="{StaticResource ResourceDetailTab}">
            <TextBlock Text="{Binding SelectedVersion.Dependencies}" TextWrapping="Wrap" Margin="0,12" />
          </TabItem>
        </TabControl>
          <WrapPanel Margin="0,16,0,0">
            <Button Content="打开项目主页" Click="WebsiteClick" />
            <Button Content="重新读取兼容版本" Click="ReloadVersionsClick" />
          </WrapPanel>
          <WrapPanel>
            <TextBox Width="130" Text="{Binding FavoriteFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="收藏夹名称" />
            <TextBox Width="180" Text="{Binding FavoriteLabels, UpdateSourceTrigger=PropertyChanged}" ToolTip="收藏标签，用逗号分隔" Margin="8,0" />
            <Button Content="保存收藏标签" Click="SaveFavoriteClick" />
          </WrapPanel>
          <TextBlock Text="{Binding FavoriteStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
          </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="DownloadOptions" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top">
            <Border Style="{StaticResource Card}" Padding="14" CornerRadius="7" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="下载选项" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Text="{Binding DetailStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                <ProgressBar Height="3" IsIndeterminate="{Binding IsDetailBusy}" Margin="0,8" />
                <TextBlock Text="资源版本" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Label" Margin="0,6,0,0" />
                <TextBlock Text="独立下载目录" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" ToolTip="外部资源下载目录；留空使用默认目录" />
                <Button Content="↓ 下载所选文件" Style="{StaticResource Primary}" IsEnabled="{Binding CanDownload}" Click="DownloadClick" Margin="0,16,0,8" />
                <TextBlock Text="依赖信息" Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding SelectedVersion.DependencySummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,12" />
                <TextBlock Text="资源文件保存到上方独立下载目录；也可以选择下方实例解析依赖后安装。" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Label" ToolTip="安装目标实例；数据包请选择具体世界" Margin="0,12,0,0" />
                <Button Content="安装到选中实例" IsEnabled="{Binding CanInstall}" Click="InstallClick" Margin="0,8,0,0" />
                <TextBlock Text="{Binding DownloadStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
