<UserControl x:Class="BlockLaunch.Front.ResourceBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="18">
      <StackPanel>
        <TextBlock Text="发现属于你的游戏内容" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Modrinth · 资源查询通过接口适配现有业务；本页不执行下载或修改实例。" Style="{StaticResource Caption}" Margin="0,8,0,12" TextWrapping="Wrap" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="搜索" Click="SearchClick" Margin="8,0,0,0" />
          <TextBox Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索名称或描述；模拟模式输入 empty / error 查看空列表和错误状态" KeyDown="SearchKeyDown" />
        </DockPanel>
        <WrapPanel Margin="0,12,0,0">
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="资源类型" Style="{StaticResource Caption}" />
            <ComboBox Width="130" SelectedValuePath="Tag" SelectedValue="{Binding Kind}">
              <ComboBoxItem Content="模组" Tag="mod" />
              <ComboBoxItem Content="资源包" Tag="resourcepack" />
              <ComboBoxItem Content="光影" Tag="shader" />
              <ComboBoxItem Content="数据包" Tag="datapack" />
              <ComboBoxItem Content="整合包" Tag="modpack" />
            </ComboBox>
          </StackPanel>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="游戏版本（可留空）" Style="{StaticResource Caption}" />
            <TextBox Width="140" Text="{Binding GameVersion, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="加载器（可留空）" Style="{StaticResource Caption}" />
            <TextBox Width="140" Text="{Binding Loader, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="排序" Style="{StaticResource Caption}" />
            <ComboBox Width="120" SelectedValuePath="Tag" SelectedValue="{Binding Sort}">
              <ComboBoxItem Content="相关性" Tag="relevance" />
              <ComboBoxItem Content="下载量" Tag="downloads" />
              <ComboBoxItem Content="最近更新" Tag="updated" />
            </ComboBox>
          </StackPanel>
        </WrapPanel>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="1" Margin="0,12">
      <ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}" />
      <TextBlock Text="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <ListBox ItemsSource="{Binding Items}" SelectionChanged="ProjectChanged" HorizontalContentAlignment="Stretch" Background="White" BorderBrush="{DynamicResource ThemeBorderBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="10">
              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Description}" Margin="0,8" TextWrapping="Wrap" />
              <TextBlock Style="{StaticResource Caption}">
                <Run Text="{Binding Author}" /><Run Text="  ·  " /><Run Text="{Binding Downloads}" /><Run Text=" 次下载" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding Selected.Title, TargetNullValue=资源详情}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Grid.Row="1" Text="{Binding DetailStatus}" Margin="0,12" TextWrapping="Wrap" />
          <ProgressBar Grid.Row="2" Height="3" IsIndeterminate="{Binding IsDetailBusy}" Margin="0,0,0,8" />
          <ListBox Grid.Row="3" ItemsSource="{Binding Versions}" DisplayMemberPath="Label" BorderThickness="0" />
        </Grid>
      </Border>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button Content="取消读取" Click="CancelClick" DockPanel.Dock="Right" />
      <StackPanel Orientation="Horizontal">
        <Button Content="上一页" IsEnabled="{Binding CanPrevious}" Click="PreviousClick" />
        <Button Content="下一页" IsEnabled="{Binding CanNext}" Click="NextClick" />
      </StackPanel>
    </DockPanel>
  </Grid>
</UserControl>
