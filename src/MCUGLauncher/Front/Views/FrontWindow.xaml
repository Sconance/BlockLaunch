<Window x:Class="BlockLaunch.Front.FrontWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCUG Launcher · Minecraft 启动器" Width="1060" Height="740" MinWidth="940" MinHeight="650"
        Background="#F3F7F9" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen">
  <Grid x:Name="SurfaceRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel x:Name="HeaderBar" Background="White">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="0,0,4,0">
        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="最小化" Click="MinimizeClick" />
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="最大化或还原" Click="MaximizeClick" />
        <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" ToolTip="关闭启动器" Click="CloseClick" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
        <Border Background="#006DB8" CornerRadius="7" Width="30" Height="30" Margin="12,6,0,6">
          <TextBlock Text="▧" FontSize="21" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="MCUG Launcher" Foreground="{DynamicResource ThemeTextBrush}" FontSize="17" FontWeight="SemiBold"
                   Width="146" Margin="8,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel x:Name="NavigationPanel" Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
        <RadioButton x:Name="StartNavigation" Style="{StaticResource CompactNav}" Content="▷  启动"
                     GroupName="FrontNavigation" Tag="start" Checked="Navigate" />
        <RadioButton x:Name="DownloadNavigation" Style="{StaticResource CompactNav}" Content="↓  下载"
                     GroupName="FrontNavigation" Tag="download" Checked="Navigate" />
        <RadioButton x:Name="SettingsNavigation" Style="{StaticResource CompactNav}" Content="⚙  设置"
                     GroupName="FrontNavigation" Tag="settings" Checked="Navigate" />
        <Button x:Name="MoreNavigation" Style="{StaticResource CompactNavButton}" Content="▦  更多" Click="OpenMoreMenu">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="账号管理" Tag="accounts" Click="NavigateMenu" />
              <MenuItem Header="◇  内容中心" Tag="resources" Click="NavigateMenu" />
              <MenuItem Header="▦  内容管理" Tag="content" Click="NavigateMenu" />
              <Separator />
              <MenuItem Header="≡  运行日志" Tag="logs" Click="NavigateMenu" />
              <MenuItem Header="↻  任务与恢复" Tag="tasks" Click="NavigateMenu" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>
      <Border />
    </DockPanel>
    <Grid Grid.Row="1" Margin="16,0,16,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="8" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock x:Name="PageTitle" Text="启动" FontSize="20" FontWeight="Bold" />
        <TextBlock x:Name="PageSubtitle" Text="选择账号和已安装版本，开始游戏。" Style="{StaticResource Caption}" FontSize="11" />
      </StackPanel>
      <ContentControl x:Name="PageHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      <TextBlock x:Name="RuntimeStatus" Grid.Row="2" Text="正在初始化…" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
    </Grid>
  </Grid>
</Window>
