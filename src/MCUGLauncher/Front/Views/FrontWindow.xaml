<Window x:Class="BlockLaunch.Front.FrontWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCUG Launcher · Front 预览" Width="1220" Height="850" MinWidth="1080" MinHeight="760"
        Background="#F3F7F9" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="214" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="White" BorderBrush="#E6EBF4" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="116" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="24,30,12,0">
          <TextBlock Text="▧ MCUG Launcher" FontSize="19" FontWeight="Bold" />
          <TextBlock Text="让每个世界，都值得期待" Style="{StaticResource Caption}" Margin="0,12,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="你的工作台" Style="{StaticResource Caption}" Margin="28,12,0,12" />
            <RadioButton x:Name="HomeNavigation" Style="{StaticResource Nav}" Content="⌂     开始游戏" GroupName="FrontNavigation" Tag="home" Checked="Navigate" />
            <RadioButton Style="{StaticResource Nav}" Content="↓     游戏安装" GroupName="FrontNavigation" Tag="install" Checked="Navigate" />
            <RadioButton Style="{StaticResource Nav}" Content="◇     内容中心" GroupName="FrontNavigation" Tag="resources" Checked="Navigate" />
            <RadioButton Style="{StaticResource Nav}" Content="▦     内容管理" GroupName="FrontNavigation" Tag="content" Checked="Navigate" />
            <Border Height="1" Background="#EDF0F7" Margin="28,20" />
            <RadioButton Style="{StaticResource Nav}" Content="⚙     启动设置" GroupName="FrontNavigation" Tag="settings" Checked="Navigate" />
            <RadioButton Style="{StaticResource Nav}" Content="≡     运行日志" GroupName="FrontNavigation" Tag="logs" Checked="Navigate" />
            <RadioButton Style="{StaticResource Nav}" Content="↻     任务与恢复" GroupName="FrontNavigation" Tag="tasks" Checked="Navigate" />
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#F7F9FE" CornerRadius="12" Margin="18" Padding="14">
          <StackPanel>
            <TextBlock Text="FRONT · 独立预览" FontWeight="Bold" />
            <TextBlock x:Name="ModeLabel" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,0,28,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="94" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="PageTitle" Text="开始游戏" FontSize="25" FontWeight="Bold" />
        <TextBlock x:Name="PageSubtitle" Text="欢迎回来，今天也去创造一点不同。" Style="{StaticResource Caption}" Margin="0,7,0,0" />
      </StackPanel>
      <ContentControl x:Name="PageHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      <TextBlock Grid.Row="2" Text="迁移预览：设置页可真实保存至独立测试目录；不会启动游戏、登录、下载或删除实例。" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
  </Grid>
</Window>
