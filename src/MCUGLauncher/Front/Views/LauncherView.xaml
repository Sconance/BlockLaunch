<UserControl x:Class="BlockLaunch.Front.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="HiddenTabs" TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Border Background="Transparent">
              <ContentPresenter ContentSource="SelectedContent" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <TextBlock x:Name="ActionStatus" VerticalAlignment="Bottom" Margin="0,0,0,2"
               TextWrapping="Wrap" AutomationProperties.Name="业务操作状态" />
    <TabControl x:Name="Pages" Style="{StaticResource HiddenTabs}" Margin="0,0,0,25">
      <TabItem Header="启动">
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
              <StackPanel>
                <UniformGrid Columns="3" Margin="0,0,0,8">
                  <RadioButton x:Name="MicrosoftMode" Content="◇ 正版" Tag="microsoft" GroupName="HomeAccount" Style="{StaticResource AccountLoginChip}" Checked="AccountModeChanged" />
                  <RadioButton x:Name="OfflineMode" Content="♧ 离线" Tag="offline" GroupName="HomeAccount" Style="{StaticResource AccountLoginChip}" Checked="AccountModeChanged" />
                  <RadioButton x:Name="MuaMode" Content="MUA 登录" Tag="mua" GroupName="HomeAccount" Style="{StaticResource AccountLoginChip}" Checked="AccountModeChanged" />
                </UniformGrid>
                <Border Width="64" Height="64" CornerRadius="10" Background="{DynamicResource ThemeInputBrush}" Padding="4" Margin="0,4,0,8" ToolTip="默认头像；在线皮肤资料尚未接入此接口">
                  <Image x:Name="Avatar" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <TextBlock x:Name="PlayerLabel" Text="Player" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="196" />
                <TextBlock x:Name="AccountSummary" Style="{StaticResource Caption}" Margin="0,4,0,9" TextWrapping="Wrap" TextAlignment="Center" />
                <StackPanel x:Name="OfflineIdentity">
                  <TextBlock Text="离线角色名" Style="{StaticResource Caption}" />
                  <TextBox x:Name="OfflineName" AutomationProperties.Name="离线玩家名称" MaxLength="16" />
                  <TextBlock Text="仅用于离线游戏，不影响正版角色。" Style="{StaticResource Caption}" FontSize="10" TextWrapping="Wrap" />
                  <Button Content="使用离线账号" Click="OfflineClick" />
                </StackPanel>
                <StackPanel x:Name="MicrosoftIdentity" Visibility="Collapsed">
                  <Button Content="登录微软账号" Click="MicrosoftClick" />
                  <Button Content="账号设置" Click="ManageAccountsClick" />
                </StackPanel>
                <StackPanel x:Name="MuaIdentity" Visibility="Collapsed">
                  <Button Content="登录 MUA 账号" Click="ManageAccountsClick" />
                  <Button Content="MUA 账号设置" Click="ManageAccountsClick" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12">
              <StackPanel>
                <ComboBox x:Name="Profiles" DisplayMemberPath="Label" SelectionChanged="ProfileChanged" Visibility="Collapsed" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                  <Button x:Name="LaunchButton" Grid.RowSpan="2" ContentTemplate="{x:Null}" Style="{StaticResource Primary}" MinHeight="70" Padding="10,9" Margin="0" Click="LaunchClick">
                    <StackPanel>
                      <TextBlock Text="▷  启动游戏" Foreground="White" FontSize="17" HorizontalAlignment="Center" />
                      <TextBlock x:Name="SelectedLabel" Text="尚未安装游戏，请前往下载" Foreground="White" FontSize="11" MaxWidth="125" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="VersionsToggle" Grid.Column="1" Content="&gt;" Click="ToggleVersionsClick" ToolTip="展开版本列表" Margin="5,0,0,3" Padding="0" />
                  <Button Grid.Column="1" Grid.Row="1" Content="⚙" Click="ManageVersionClick" ToolTip="管理当前版本" Margin="5,3,0,0" Padding="0" />
                </Grid>
                <Button x:Name="StopButton" Content="■ 关闭正在运行的游戏" Click="StopClick" Visibility="Collapsed" />
              </StackPanel>
            </Border>
          </StackPanel>
          <Border x:Name="VersionsPanel" Grid.Column="2" Padding="4,0,0,0" Visibility="Collapsed">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
              </Grid.RowDefinitions>
              <StackPanel>
                <DockPanel>
                  <WrapPanel DockPanel.Dock="Right"><Button Content="导入整合包" Click="ImportClick" /><Button Content="刷新版本" Click="RefreshProfilesClick" /></WrapPanel>
                  <TextBlock Text="游戏目录" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="RootLabel" TextTrimming="CharacterEllipsis" Margin="0,4,0,8" />
              </StackPanel>
              <TextBox x:Name="ProfileSearch" Grid.Row="1" ToolTip="搜索已安装版本" TextChanged="SearchProfilesChanged" />
              <ListBox x:Name="ProfileCards" Grid.Row="2" SelectionChanged="ProfileCardChanged" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="12,9" Margin="0,0,0,7" Background="{DynamicResource ThemeInputBrush}" CornerRadius="8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="32" />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="◇" FontSize="22" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                          <TextBlock Text="已安装 · 点击选择此版本" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="账号">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <TextBlock Text="账号管理" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="当前账号和认证方式" Style="{StaticResource Caption}" Margin="0,8,0,12" />
            <Button Content="← 返回启动" Click="BackHomeClick" HorizontalAlignment="Left" />
            <TextBlock Text="离线名称（3–16 位英文、数字或下划线）" Margin="0,12,0,4" />
            <TextBox x:Name="OfflineNameDetails" Text="{Binding ElementName=OfflineName, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="离线玩家名称详情" />
            <Button Content="使用离线账号" Click="OfflineClick" HorizontalAlignment="Left" />
            <WrapPanel Margin="0,12">
              <Button Content="微软正版登录" Click="MicrosoftClick" />
              <Button Content="使用已保存的微软账号" Click="SelectMicrosoftClick" />
              <Button Content="清除微软登录" Click="ForgetMicrosoftClick" />
            </WrapPanel>
            <TextBlock Text="MUA 账号" />
            <TextBox x:Name="MuaAccount" AutomationProperties.Name="MUA 账号" />
            <TextBlock Text="MUA 密码（不写入设置或日志）" Margin="0,8,0,4" />
            <PasswordBox x:Name="MuaPassword" AutomationProperties.Name="MUA 密码" />
            <WrapPanel Margin="0,12">
              <Button Content="登录 MUA" Click="MuaClick" />
              <Button Content="使用已保存的 MUA 账号" Click="SelectMuaClick" />
              <Button Content="退出 MUA" Click="ForgetMuaClick" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="本地内容">
        <DockPanel Margin="14">
          <StackPanel DockPanel.Dock="Top">
            <Button Content="← 返回启动" Click="BackHomeClick" HorizontalAlignment="Left" />
            <TextBlock Text="使用当前启动页选择的实例；运行游戏或下载时禁止修改。" TextWrapping="Wrap" />
            <WrapPanel Margin="0,12">
              <Button Content="读取本地内容" Click="ContentClick" />
              <Button Content="启用 / 禁用所选资源" Click="ToggleContentClick" />
            </WrapPanel>
          </StackPanel>
          <ListBox x:Name="LocalContent" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="6">
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                  <TextBlock Text="{Binding State}" />
                  <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="安装">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <StackPanel x:Name="GameInstallPanel">
            <TextBlock Text="游戏安装" FontSize="22" FontWeight="Bold" />
            <Button Content="刷新版本" Click="RefreshProfilesClick" HorizontalAlignment="Left" />
            <TextBlock Text="游戏版本" Style="{StaticResource Caption}" />
            <ComboBox x:Name="InstallProfiles" DisplayMemberPath="Label" SelectionChanged="InstallProfileChanged" />
            <TextBlock Text="选择版本与加载器后加入下载队列。" Style="{StaticResource Caption}" Margin="0,8,0,12" />
            <TextBlock Text="加载器" />
            <ComboBox x:Name="Loader" SelectedIndex="0" SelectionChanged="LoaderChanged">
              <ComboBoxItem Content="原版" Tag="vanilla" />
              <ComboBoxItem Content="Fabric" Tag="fabric" />
              <ComboBoxItem Content="Forge" Tag="forge" />
              <ComboBoxItem Content="NeoForge" Tag="neoforge" />
              <ComboBoxItem Content="Quilt" Tag="quilt" />
            </ComboBox>
            <Button Content="读取兼容加载器版本" Click="LoadersClick" HorizontalAlignment="Left" />
            <ComboBox x:Name="LoaderVersions" DisplayMemberPath="Label" />
            <Button Content="加入真实安装队列" Style="{StaticResource Primary}" Click="InstallClick" HorizontalAlignment="Left" Margin="0,12,0,0" />
            </StackPanel>
            <StackPanel x:Name="PackImportPanel">
            <TextBlock Text="本地整合包（.mrpack / .zip）" Margin="0,18,0,8" />
            <TextBlock Text="导入会读取整合包要求并加入共享下载队列，不直接执行未确认的安装。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Button Content="选择并导入整合包" Click="ImportClick" HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
