<local:LauncherPage xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:BlockLaunch" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BlockLaunch.HeadingPageView">
  <Grid>
    <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="PageTitle" Text="开始游戏" FontSize="25" FontWeight="Bold" />
      <TextBlock x:Name="PageSubtitle" Text="欢迎回来，今天也去创造一点不同。" Style="{StaticResource Caption}" Margin="0,7,0,0" />
    </StackPanel>
    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="White" CornerRadius="18" Padding="14,8">
      <StackPanel Orientation="Horizontal">
        <Ellipse Fill="#6EC5A0" Width="7" Height="7" Margin="0,0,8,0" />
        <TextBlock Text="Minecraft Java Edition" FontSize="11" Foreground="#647782" />
      </StackPanel>
    </Border>
  </Grid>
</local:LauncherPage>