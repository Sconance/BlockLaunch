<local:LauncherPage xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:BlockLaunch" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BlockLaunch.ContentManagementPageView">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="#EAF3F8" CornerRadius="10" Padding="14,10">
      <TextBlock x:Name="ManageTarget" Text="当前实例" Foreground="#466779" TextWrapping="Wrap" />
    </Border>
    <WrapPanel Grid.Row="1" Margin="0,12,0,9">
      <Button Content="导入本地模组" Click="ImportModClick" Style="{StaticResource Primary}" />
      <Button Content="导入资源包" Click="ImportResourceClick" />
      <Button Content="刷新" Click="RefreshContentClick" />
      <Button Content="打开 mods" Click="ModsFolderClick" />
      <Button Content="打开备份目录" Click="TrashFolderClick" />
    </WrapPanel>
    <ListBox Grid.Row="2" x:Name="InstalledContent">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="92" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,7,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF3F8" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5">
              <TextBlock Text="{Binding State}" Foreground="#7088C4" FontSize="11" />
            </Border>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
      <Button Content="启用 / 禁用" Click="ToggleContentClick" />
      <Button Content="更新所选内容" Click="UpdateContentClick" />
      <Button Content="批量检查更新" Click="CheckAllUpdatesClick" />
      <Button Content="回退最近内容操作" Click="RestoreContentClick" />
      <Button Content="移至备份" Click="RemoveContentClick" />
      <TextBlock Text="更新支持由本启动器安装的内容" VerticalAlignment="Center" Style="{StaticResource Caption}" />
    </WrapPanel>
  </Grid>
</local:LauncherPage>