<local:LauncherPage xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:BlockLaunch" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BlockLaunch.TasksPageView">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="下载按加入顺序执行。暂停保留缓存，继续会校验并恢复；重启后自动恢复排队和意外中断的任务，已暂停任务保持暂停。" TextWrapping="Wrap" Margin="0,0,0,16" Foreground="#647782" />
    <ListBox Grid.Row="1" x:Name="TaskHistoryList">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel>
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#647782" Margin="0,8,0,0" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel Grid.Row="2">
      <Button Content="暂停" Click="PauseDownloadClick" />
      <Button Content="继续 / 失败重试" Click="ResumeDownloadClick" />
      <Button Content="取消下载" Click="CancelDownloadClick" />
      <Button Content="刷新任务记录" Click="RefreshOperationsClick" />
      <Button Content="定位实例与恢复说明" Click="LocateOperationClick" />
    </WrapPanel>
  </Grid>
</local:LauncherPage>