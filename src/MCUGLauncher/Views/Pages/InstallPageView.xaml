<local:LauncherPage xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:BlockLaunch" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BlockLaunch.InstallPageView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="原版游戏" FontSize="19" FontWeight="SemiBold" />
          <WrapPanel x:Name="InstallActions" Margin="0,12,0,0" />
          <TextBlock Text="在版本列表中选择要下载的游戏；安装完成后会出现在首页。" Foreground="#647782" Margin="0,9,0,18" />
          <TextBlock x:Name="InstallTarget" Text="请先选择要下载的版本" FontWeight="SemiBold" />
          <WrapPanel Margin="0,14,0,0">
            <Button Content="↓  下载 / 修复" Style="{StaticResource Primary}" Click="InstallClick" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="整合包" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="从内容中心搜索下载，或导入 Modrinth / MultiMC / Prism 整合包。" Foreground="#647782" TextWrapping="Wrap" Margin="0,9,0,12" />
          <Button Content="导入本地整合包 .mrpack / .zip" Click="ImportPackClick" Style="{StaticResource Primary}" HorizontalAlignment="Left" />
          <CheckBox x:Name="PackOptional" Content="同时安装整合包的可选客户端文件" Foreground="#647782" Margin="0,12,0,0" />
          <TextBlock Text="每个整合包拥有独立的模组、配置与存档，安装后自动出现在首页版本列表。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="安装模组加载器" FontSize="19" FontWeight="SemiBold" />
          <WrapPanel x:Name="LoaderActions" Margin="0,12,0,0" />
          <TextBlock Text="选择官方原版后安装加载器；完成后会自动选中新版本。" Foreground="#647782" Margin="0,9,0,18" />
          <WrapPanel>
            <Button Content="安装 Fabric 稳定版" Click="FabricClick" Style="{StaticResource Primary}" />
            <Button Content="安装 Quilt 稳定版" Click="QuiltClick" />
          </WrapPanel>
          <TextBlock Text="Forge / NeoForge：可在上方选择版本自动安装，也可使用本地官方安装器。" Foreground="#647782" Margin="0,19,0,8" TextWrapping="Wrap" />
          <Button Content="选择 Forge / NeoForge 安装器 .jar" Click="LoaderJarClick" HorizontalAlignment="Left" />
          <TextBlock Text="官方安装器的安装目录须设为设置页中的游戏根目录；安装后刷新版本。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <Border Background="#E8F2F8" CornerRadius="12" Padding="18" Margin="0,16,0,0">
        <TextBlock Text="每个版本独立保存存档、模组与配置。下载的模组会安装到当前选中版本的实例目录。" Foreground="#657BAA" TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</local:LauncherPage>