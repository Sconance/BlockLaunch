<local:LauncherPage xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:BlockLaunch" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BlockLaunch.LogsPageView">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <TextBlock Text="启动器与游戏实时输出（敏感字段已过滤）" Margin="0,0,0,10" />
    <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0" Background="#F8FAFE" />
    <WrapPanel Grid.Row="2" Margin="0,8">
      <Button Content="刷新最近启动实例 latest.log" Click="ReadGameLogClick" />
      <Button Content="打开日志目录" Click="LogsFolderClick" />
    </WrapPanel>
    <TextBox Grid.Row="3" x:Name="GameLogView" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0" Background="#F8FAFE" Text="点击刷新读取游戏仍在写入的日志，最多显示末尾 64 KB。" />
  </Grid>
</local:LauncherPage>