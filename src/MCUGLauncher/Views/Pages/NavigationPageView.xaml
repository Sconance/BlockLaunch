<local:LauncherPage xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:BlockLaunch" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BlockLaunch.NavigationPageView">
  <Border Background="White" BorderBrush="#E6EBF4" BorderThickness="0,0,1,0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="116" />
        <RowDefinition />
        <RowDefinition Height="106" />
      </Grid.RowDefinitions>
      <StackPanel Margin="26,30,0,0">
        <StackPanel Orientation="Horizontal">
          <Border Background="#006DB8" CornerRadius="9" Width="33" Height="33">
            <TextBlock Text="▧" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="MCUG Launcher" FontSize="19" FontWeight="Bold" Margin="10,3,0,0" />
        </StackPanel>
        <TextBlock Text="让每个世界，都值得期待" Style="{StaticResource Caption}" Margin="1,12,0,0" />
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="你的工作台" Style="{StaticResource Caption}" Margin="29,12,0,12" />
          <RadioButton x:Name="HomeNav" Style="{StaticResource Nav}" Content="⌂     开始游戏" Tag="0" GroupName="Navigation" IsChecked="True" Checked="Navigate" />
          <RadioButton Style="{StaticResource Nav}" Content="↓     游戏安装" Tag="1" GroupName="Navigation" Checked="Navigate" />
          <RadioButton x:Name="DiscoverNav" Style="{StaticResource Nav}" Content="◇     内容中心" Tag="2" GroupName="Navigation" Checked="Navigate" />
          <RadioButton x:Name="ManageNav" Style="{StaticResource Nav}" Content="▦     内容管理" Tag="3" GroupName="Navigation" Checked="Navigate" />
          <Border Height="1" Background="#EDF0F7" Margin="28,20" />
          <RadioButton x:Name="SettingsNav" Style="{StaticResource Nav}" Content="⚙     启动设置" Tag="4" GroupName="Navigation" Checked="Navigate" />
          <RadioButton Style="{StaticResource Nav}" Content="≡     运行日志" Tag="5" GroupName="Navigation" Checked="Navigate" />
          <RadioButton Style="{StaticResource Nav}" Content="↻     任务与恢复" Tag="6" GroupName="Navigation" Checked="Navigate" />
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="#F7F9FE" CornerRadius="12" Margin="18,12,18,20" Padding="14">
        <StackPanel>
          <TextBlock x:Name="VersionLabel" Text="BLOCKLAUNCH" FontSize="10" FontWeight="Bold" Foreground="#7E8BB0" />
          <TextBlock Text="独立制作 · Java Edition" Style="{StaticResource Caption}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</local:LauncherPage>