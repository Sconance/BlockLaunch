<local:LauncherPage xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:BlockLaunch" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BlockLaunch.ResourcePageView">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="45" />
    </Grid.RowDefinitions>
    <Border Background="#EAF3F8" CornerRadius="10" Padding="14,10">
      <TextBlock x:Name="ContentTarget" Text="安装目标：请先选择游戏版本" Foreground="#466779" TextWrapping="Wrap" />
    </Border>
    <Grid Grid.Row="1" Margin="0,12,0,9">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="132" />
        <ColumnDefinition Width="90" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchQuery" ToolTip="输入名称或关键词，如 Sodium、JEI、地图" KeyDown="SearchKeyDown" Margin="0,0,10,0" />
      <ComboBox Grid.Column="1" x:Name="ContentType" SelectedIndex="0" Margin="0,0,10,0" SelectionChanged="ContentTypeChanged">
        <ComboBoxItem Content="模组" />
        <ComboBoxItem Content="资源包" />
        <ComboBoxItem Content="整合包" />
      </ComboBox>
      <Button Grid.Column="2" Content="搜索" Style="{StaticResource Primary}" Click="SearchClick" Margin="0" />
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>
      <Grid>
        <ListBox x:Name="SearchResults" SelectionChanged="ProjectChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="48" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Background="#E9EFFD" CornerRadius="11" Width="38" Height="38" VerticalAlignment="Top">
                  <Grid>
                    <TextBlock Text="{Binding Initial}" FontSize="20" Foreground="#6A87D5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding IconUrl}" Stretch="Uniform" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                  <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="38" Foreground="#647782" FontSize="11" Margin="0,7,0,8" />
                  <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="#98A3B8" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="SearchHint" Text="搜一搜，发现新的玩法。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9BA6BB" IsHitTestVisible="False" />
      </Grid>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="项目详情" Style="{StaticResource Caption}" />
            <TextBlock x:Name="ProjectTitle" Text="选择一个项目" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,10" />
            <TextBlock x:Name="ProjectDescription" Text="选择左侧项目，查看与当前游戏匹配的版本。" TextWrapping="Wrap" Foreground="#647782" FontSize="12" />
            <TextBlock Text="可用版本" Margin="0,25,0,0" Style="{StaticResource Caption}" />
            <ComboBox x:Name="ProjectVersions">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="InstallContentButton" Content="↓  安装到当前实例" Style="{StaticResource Primary}" Click="InstallContentClick" Margin="0,5,0,0" IsEnabled="False" />
            <TextBlock Text="模组解析必需依赖；整合包准备指定游戏和加载器。下载均进行哈希校验。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,0,14" />
            <Button Content="在 Modrinth 查看项目 ↗" Click="ProjectPageClick" Margin="0" Padding="8,9" />
            <Border Height="1" Background="#E9EDF5" Margin="0,20" />
            <TextBlock Text="整合包安装为独立实例。模组与资源包安装到首页选中的实例。" Style="{StaticResource Caption}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Grid Grid.Row="3">
      <TextBlock x:Name="SearchSummary" Text="内容来自 Modrinth" Style="{StaticResource Caption}" VerticalAlignment="Center" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button Content="← 上一页" Click="PreviousSearch" Padding="10,6" />
        <Button Content="下一页 →" Click="NextSearch" Padding="10,6" Margin="0,4,0,4" />
      </StackPanel>
    </Grid>
  </Grid>
</local:LauncherPage>