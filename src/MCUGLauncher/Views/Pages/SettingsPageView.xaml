<local:LauncherPage xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:BlockLaunch" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BlockLaunch.SettingsPageView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="游戏与 Java" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,19" />
          <TextBlock Text="游戏根目录" Style="{StaticResource Caption}" />
          <TextBox x:Name="GameRoot" />
          <TextBlock Text="Java 可执行文件 · 留空自动管理" Style="{StaticResource Caption}" />
          <TextBox x:Name="JavaPath" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="24" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="最大内存 / MB" Style="{StaticResource Caption}" />
              <TextBox x:Name="Memory" Text="4096" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="游戏窗口 / 宽 × 高" Style="{StaticResource Caption}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GameWidth" Text="1280" />
                <TextBox Grid.Column="2" x:Name="GameHeight" Text="720" />
              </Grid>
            </StackPanel>
          </Grid>
          <Button Content="保存设置" Style="{StaticResource Primary}" Click="SaveClick" HorizontalAlignment="Left" />
          <Button Content="下载与网络设置" Click="NetworkClick" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="关于 MCUG Launcher" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="参考 PCL / HMCL / SJMCL 的使用习惯，独立设计与实现。非 Mojang / Microsoft 官方产品。" TextWrapping="Wrap" Foreground="#647782" Margin="0,10,0,0" />
          <Button Content="第三方许可与源码参考" Click="NoticesClick" HorizontalAlignment="Left" Margin="0,10,0,0" />
          <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,9,0,0">
            <Run x:Name="VersionText" />
            <Run Text=" · 微软与 MUA 账号凭据使用 Windows 用户级加密保存，正版启动前验证和刷新。" />
          </TextBlock>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</local:LauncherPage>