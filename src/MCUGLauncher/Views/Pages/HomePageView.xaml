<local:LauncherPage xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:BlockLaunch" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BlockLaunch.HomePageView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border Height="184" CornerRadius="18" ClipToBounds="True">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
            <GradientStop Color="#5A7DE7" />
            <GradientStop Color="#8D9EEA" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <StackPanel Margin="28,25,0,0" HorizontalAlignment="Left">
            <TextBlock Text="A NEW ADVENTURE AWAITS" FontSize="10" Foreground="#DCE5FF" FontWeight="Bold" />
            <TextBlock Text="下一个世界，由你创造。" FontSize="27" FontWeight="Bold" Foreground="White" Margin="0,13,0,0" />
            <TextBlock Text="从熟悉的方块，走向未知的远方。" Foreground="#E0E7FF" FontSize="12" Margin="0,10,0,0" />
            <Border Background="#28FFFFFF" CornerRadius="10" HorizontalAlignment="Left" Padding="10,4" Margin="0,15,0,0">
              <TextBlock Text="探索  /  建造  /  无限可能" FontSize="10" Foreground="White" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="290" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Text="准备出发" FontSize="17" FontWeight="SemiBold" />
              <TextBlock x:Name="LocalCount" Text="本地版本  0" HorizontalAlignment="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="选择游戏版本" Style="{StaticResource Caption}" Margin="0,19,0,0" />
            <ComboBox x:Name="Versions" SelectedValuePath="Id" SelectionChanged="VersionChanged">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Grid>
              <CheckBox x:Name="Snapshots" Visibility="Collapsed" Content="显示快照" Foreground="#647782" FontSize="11" Checked="FilterChanged" Unchecked="FilterChanged" />
              <Button Content="刷新列表 ↻" Click="RefreshClick" HorizontalAlignment="Right" Margin="0,-4,0,0" Padding="9,5" FontSize="11" />
            </Grid>
            <Button x:Name="LaunchGameButton" Content="▶    启动游戏" Style="{StaticResource Primary}" Click="LaunchClick" FontSize="17" Padding="20,15" Margin="0,21,0,0" />
            <Button x:Name="StopGameButton" Visibility="Collapsed" Content="■  关闭正在运行的游戏" Click="StopClick" Margin="0,9,0,0" Padding="10,7" />
            <Button Content="＋ 新建同版本独立实例" Click="NewInstanceClick" Margin="0,9,0,0" Padding="10,7" />
            <TextBlock x:Name="InstalledVersionsHint" Text="其他版本请到「游戏安装」下载。" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="玩家档案" FontSize="15" FontWeight="SemiBold" />
            <Border Width="96" Height="96" Background="#EAF3F8" CornerRadius="12" HorizontalAlignment="Center" Padding="6" Margin="0,18,0,10">
              <Image x:Name="SkinAvatar" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <TextBlock x:Name="AvatarPlayerName" Text="Player" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="AccountStatus" Text="离线冒险家" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <TextBlock x:Name="AvatarCaption" Text="默认头像" Style="{StaticResource Caption}" HorizontalAlignment="Center" FontSize="10" Margin="0,5,0,0" />
            <Button Content="刷新头像" Click="RefreshAvatarClick" Padding="8,5" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0" />
            <ComboBox x:Name="AccountMode" SelectedIndex="0" Margin="0,18,0,0">
              <ComboBoxItem Content="离线账号" />
              <ComboBoxItem Content="微软正版账号" />
            </ComboBox>
            <TextBox x:Name="PlayerName" Text="Player" MaxLength="16" Margin="0,10,0,4" />
            <Button Content="微软账号登录  →" Click="LoginClick" Margin="0,7,0,0" />
            <TextBlock Text="正版登录通过微软官方授权完成" Style="{StaticResource Caption}" FontSize="10" Margin="0,12,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</local:LauncherPage>