<Window x:Class="MCUGLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MCUG Launcher"
        Width="1200" Height="780"
        MinWidth="960" MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F3F7F9"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <wv2:WebView2 x:Name="Browser" />
        <Border x:Name="LoadingLayer" Background="#F3F7F9">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="MCUG Launcher" FontSize="24" FontWeight="Bold" Foreground="#1D2B35" HorizontalAlignment="Center" />
                <TextBlock Text="正在加载" FontSize="12" Foreground="#5F717D" Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
