<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:BlockLaunch" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BlockLaunch.MainWindow" Title="MCUG Launcher · Minecraft 启动器" Width="1220" Height="850" MinWidth="1080" MinHeight="760" Background="#F3F7F9" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="214" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <local:NavigationPageView x:Name="NavigationPageView" />
    <Grid Grid.Column="1" Margin="28,0,28,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="94" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <local:HeadingPageView x:Name="HeadingPageView" />
      <TabControl x:Name="MainTabs" SelectedIndex="0" Grid.Row="1" Style="{StaticResource PageTabs}">
        <TabItem Header="开始游戏">
          <local:HomePageView x:Name="HomePageView" />
        </TabItem>
        <TabItem Header="游戏安装">
          <local:InstallPageView x:Name="InstallPageView" />
        </TabItem>
        <TabItem Header="发现模组">
          <local:ResourcePageView x:Name="ResourcePageView" />
        </TabItem>
        <TabItem Header="内容管理">
          <local:ContentManagementPageView x:Name="ContentManagementPageView" />
        </TabItem>
        <TabItem Header="启动设置">
          <local:SettingsPageView x:Name="SettingsPageView" />
        </TabItem>
        <TabItem Header="运行日志">
          <local:LogsPageView x:Name="LogsPageView" />
        </TabItem>
        <TabItem Header="任务与恢复">
          <local:TasksPageView x:Name="TasksPageView" />
        </TabItem>
      </TabControl>
      <Grid x:Name="TaskStatusBar" Grid.Row="2" Height="57" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition Height="4" />
          <RowDefinition Height="10" />
        </Grid.RowDefinitions>
        <Button x:Name="CancelTaskButton" Content="取消任务" Click="CancelTaskClick" HorizontalAlignment="Right" Padding="10,5" Margin="0" IsEnabled="False" />
        <TextBlock Margin="0,0,100,0" x:Name="Status" Text="正在初始化…" FontSize="11" Foreground="#8F9BB2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Row="1" x:Name="Progress" Height="3" Foreground="#6384E8" Background="#E6ECF8" BorderThickness="0" />
      </Grid>
    </Grid>
  </Grid>
</Window>