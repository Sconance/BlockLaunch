<Window x:Class="BlockLaunch.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MCUG Launcher · Minecraft 启动器" Width="1220" Height="850" MinWidth="1080" MinHeight="760" Background="#F3F7F9" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="#E6EBF4" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="116"/><RowDefinition/><RowDefinition Height="106"/></Grid.RowDefinitions>
   <StackPanel Margin="26,30,0,0"><StackPanel Orientation="Horizontal"><Border Background="#006DB8" CornerRadius="9" Width="33" Height="33"><TextBlock Text="▧" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="MCUG Launcher" FontSize="19" FontWeight="Bold" Margin="10,3,0,0"/></StackPanel><TextBlock Text="让每个世界，都值得期待" Style="{StaticResource Caption}" Margin="1,12,0,0"/></StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="你的工作台" Style="{StaticResource Caption}" Margin="29,12,0,12"/>
    <RadioButton x:Name="HomeNav" Style="{StaticResource Nav}" Content="⌂     开始游戏" Tag="0" GroupName="Navigation" IsChecked="True" Checked="Navigate"/>
    <RadioButton Style="{StaticResource Nav}" Content="↓     游戏安装" Tag="1" GroupName="Navigation" Checked="Navigate"/>
    <RadioButton x:Name="DiscoverNav" Style="{StaticResource Nav}" Content="◇     内容中心" Tag="2" GroupName="Navigation" Checked="Navigate"/>
    <RadioButton x:Name="ManageNav" Style="{StaticResource Nav}" Content="▦     内容管理" Tag="3" GroupName="Navigation" Checked="Navigate"/>
    <Border Height="1" Background="#EDF0F7" Margin="28,20"/>
    <RadioButton Style="{StaticResource Nav}" Content="⚙     启动设置" Tag="4" GroupName="Navigation" Checked="Navigate"/>
    <RadioButton Style="{StaticResource Nav}" Content="≡     运行日志" Tag="5" GroupName="Navigation" Checked="Navigate"/><RadioButton Style="{StaticResource Nav}" Content="↻     任务与恢复" Tag="6" GroupName="Navigation" Checked="Navigate"/>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="2" Background="#F7F9FE" CornerRadius="12" Margin="18,12,18,20" Padding="14"><StackPanel><TextBlock Text="BLOCKLAUNCH  /  0.15.2" FontSize="10" FontWeight="Bold" Foreground="#7E8BB0"/><TextBlock Text="独立制作 · Java Edition" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></Border>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="28,0,28,0"><Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="开始游戏" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="欢迎回来，今天也去创造一点不同。" Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="White" CornerRadius="18" Padding="14,8"><StackPanel Orientation="Horizontal"><Ellipse Fill="#6EC5A0" Width="7" Height="7" Margin="0,0,8,0"/><TextBlock Text="Minecraft Java Edition" FontSize="11" Foreground="#647782"/></StackPanel></Border></Grid>
   <TabControl x:Name="MainTabs" SelectedIndex="0" Grid.Row="1" Style="{StaticResource PageTabs}">
    <TabItem Header="开始游戏"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Height="184" CornerRadius="18" ClipToBounds="True"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5"><GradientStop Color="#5A7DE7"/><GradientStop Color="#8D9EEA" Offset="1"/></LinearGradientBrush></Border.Background><Grid><StackPanel Margin="28,25,0,0" HorizontalAlignment="Left"><TextBlock Text="A NEW ADVENTURE AWAITS" FontSize="10" Foreground="#DCE5FF" FontWeight="Bold"/><TextBlock Text="下一个世界，由你创造。" FontSize="27" FontWeight="Bold" Foreground="White" Margin="0,13,0,0"/><TextBlock Text="从熟悉的方块，走向未知的远方。" Foreground="#E0E7FF" FontSize="12" Margin="0,10,0,0"/><Border Background="#28FFFFFF" CornerRadius="10" HorizontalAlignment="Left" Padding="10,4" Margin="0,15,0,0"><TextBlock Text="探索  /  建造  /  无限可能" FontSize="10" Foreground="White"/></Border></StackPanel></Grid></Border>
     <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="准备出发" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="LocalCount" Text="本地版本  0" HorizontalAlignment="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/></Grid><TextBlock Text="选择游戏版本" Style="{StaticResource Caption}" Margin="0,19,0,0"/><ComboBox x:Name="Versions" SelectedValuePath="Id" SelectionChanged="VersionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Grid><CheckBox x:Name="Snapshots" Visibility="Collapsed" Content="显示快照" Foreground="#647782" FontSize="11" Checked="FilterChanged" Unchecked="FilterChanged"/><Button Content="刷新列表 ↻" Click="RefreshClick" HorizontalAlignment="Right" Margin="0,-4,0,0" Padding="9,5" FontSize="11"/></Grid><Button x:Name="LaunchGameButton" Content="▶    启动游戏" Style="{StaticResource Primary}" Click="LaunchClick" FontSize="17" Padding="20,15" Margin="0,21,0,0"/><Button x:Name="StopGameButton" Visibility="Collapsed" Content="■  关闭正在运行的游戏" Click="StopClick" Margin="0,9,0,0" Padding="10,7"/><Button Content="＋ 新建同版本独立实例" Click="NewInstanceClick" Margin="0,9,0,0" Padding="10,7"/><TextBlock x:Name="InstalledVersionsHint" Text="其他版本请到「游戏安装」下载。" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="玩家档案" FontSize="15" FontWeight="SemiBold"/><Border Width="96" Height="96" Background="#EAF3F8" CornerRadius="12" HorizontalAlignment="Center" Padding="6" Margin="0,18,0,10"><Image x:Name="SkinAvatar" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border><TextBlock x:Name="AvatarPlayerName" Text="Player" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="AccountStatus" Text="离线冒险家" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0"/><TextBlock x:Name="AvatarCaption" Text="默认头像" Style="{StaticResource Caption}" HorizontalAlignment="Center" FontSize="10" Margin="0,5,0,0"/><Button Content="刷新头像" Click="RefreshAvatarClick" Padding="8,5" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0"/><ComboBox x:Name="AccountMode" SelectedIndex="0" Margin="0,18,0,0"><ComboBoxItem Content="离线账号"/><ComboBoxItem Content="微软正版账号"/></ComboBox><TextBox x:Name="PlayerName" Text="Player" MaxLength="16" Margin="0,10,0,4"/><Button Content="微软账号登录  →" Click="LoginClick" Margin="0,7,0,0"/><TextBlock Text="正版登录通过微软官方授权完成" Style="{StaticResource Caption}" FontSize="10" Margin="0,12,0,0"/></StackPanel></Border>
     </Grid>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="游戏安装"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="原版游戏" FontSize="19" FontWeight="SemiBold"/><WrapPanel x:Name="InstallActions" Margin="0,12,0,0"/><TextBlock Text="在版本列表中选择要下载的游戏；安装完成后会出现在首页。" Foreground="#647782" Margin="0,9,0,18"/><TextBlock x:Name="InstallTarget" Text="请先选择要下载的版本" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,0"><Button Content="↓  下载 / 修复" Style="{StaticResource Primary}" Click="InstallClick"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="整合包" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="从内容中心搜索下载，或导入 Modrinth / MultiMC / Prism 整合包。" Foreground="#647782" TextWrapping="Wrap" Margin="0,9,0,12"/><Button Content="导入本地整合包 .mrpack / .zip" Click="ImportPackClick" Style="{StaticResource Primary}" HorizontalAlignment="Left"/><CheckBox x:Name="PackOptional" Content="同时安装整合包的可选客户端文件" Foreground="#647782" Margin="0,12,0,0"/><TextBlock Text="每个整合包拥有独立的模组、配置与存档，安装后自动出现在首页版本列表。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="安装模组加载器" FontSize="19" FontWeight="SemiBold"/><WrapPanel x:Name="LoaderActions" Margin="0,12,0,0"/><TextBlock Text="选择官方原版后安装加载器；完成后会自动选中新版本。" Foreground="#647782" Margin="0,9,0,18"/><WrapPanel><Button Content="安装 Fabric 稳定版" Click="FabricClick" Style="{StaticResource Primary}"/><Button Content="安装 Quilt 稳定版" Click="QuiltClick"/></WrapPanel><TextBlock Text="Forge / NeoForge：可在上方选择版本自动安装，也可使用本地官方安装器。" Foreground="#647782" Margin="0,19,0,8" TextWrapping="Wrap"/><Button Content="选择 Forge / NeoForge 安装器 .jar" Click="LoaderJarClick" HorizontalAlignment="Left"/><TextBlock Text="官方安装器的安装目录须设为设置页中的游戏根目录；安装后刷新版本。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border><Border Background="#E8F2F8" CornerRadius="12" Padding="18" Margin="0,16,0,0"><TextBlock Text="每个版本独立保存存档、模组与配置。下载的模组会安装到当前选中版本的实例目录。" Foreground="#657BAA" TextWrapping="Wrap"/></Border></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="发现模组"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="45"/></Grid.RowDefinitions><Border Background="#EAF3F8" CornerRadius="10" Padding="14,10"><TextBlock x:Name="ContentTarget" Text="安装目标：请先选择游戏版本" Foreground="#466779" TextWrapping="Wrap"/></Border><Grid Grid.Row="1" Margin="0,12,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="132"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox x:Name="SearchQuery" ToolTip="输入名称或关键词，如 Sodium、JEI、地图" KeyDown="SearchKeyDown" Margin="0,0,10,0"/><ComboBox Grid.Column="1" x:Name="ContentType" SelectedIndex="0" Margin="0,0,10,0" SelectionChanged="ContentTypeChanged"><ComboBoxItem Content="模组"/><ComboBoxItem Content="资源包"/><ComboBoxItem Content="整合包"/></ComboBox><Button Grid.Column="2" Content="搜索" Style="{StaticResource Primary}" Click="SearchClick" Margin="0"/></Grid>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><Grid><ListBox x:Name="SearchResults" SelectionChanged="ProjectChanged"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#E9EFFD" CornerRadius="11" Width="38" Height="38" VerticalAlignment="Top"><Grid><TextBlock Text="{Binding Initial}" FontSize="20" Foreground="#6A87D5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding IconUrl}" Stretch="Uniform"/></Grid></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="38" Foreground="#647782" FontSize="11" Margin="0,7,0,8"/><TextBlock Text="{Binding Meta}" FontSize="10" Foreground="#98A3B8"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="SearchHint" Text="搜一搜，发现新的玩法。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9BA6BB" IsHitTestVisible="False"/></Grid><Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="项目详情" Style="{StaticResource Caption}"/><TextBlock x:Name="ProjectTitle" Text="选择一个项目" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,10"/><TextBlock x:Name="ProjectDescription" Text="选择左侧项目，查看与当前游戏匹配的版本。" TextWrapping="Wrap" Foreground="#647782" FontSize="12"/><TextBlock Text="可用版本" Margin="0,25,0,0" Style="{StaticResource Caption}"/><ComboBox x:Name="ProjectVersions"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button x:Name="InstallContentButton" Content="↓  安装到当前实例" Style="{StaticResource Primary}" Click="InstallContentClick" Margin="0,5,0,0" IsEnabled="False"/><TextBlock Text="模组解析必需依赖；整合包准备指定游戏和加载器。下载均进行哈希校验。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,0,14"/><Button Content="在 Modrinth 查看项目 ↗" Click="ProjectPageClick" Margin="0" Padding="8,9"/><Border Height="1" Background="#E9EDF5" Margin="0,20"/><TextBlock Text="整合包安装为独立实例。模组与资源包安装到首页选中的实例。" Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border></Grid><Grid Grid.Row="3"><TextBlock x:Name="SearchSummary" Text="内容来自 Modrinth" Style="{StaticResource Caption}" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="← 上一页" Click="PreviousSearch" Padding="10,6"/><Button Content="下一页 →" Click="NextSearch" Padding="10,6" Margin="0,4,0,4"/></StackPanel></Grid>
    </Grid></TabItem>
    <TabItem Header="内容管理"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#EAF3F8" CornerRadius="10" Padding="14,10"><TextBlock x:Name="ManageTarget" Text="当前实例" Foreground="#466779" TextWrapping="Wrap"/></Border><WrapPanel Grid.Row="1" Margin="0,12,0,9"><Button Content="导入本地模组" Click="ImportModClick" Style="{StaticResource Primary}"/><Button Content="导入资源包" Click="ImportResourceClick"/><Button Content="刷新" Click="RefreshContentClick"/><Button Content="打开 mods" Click="ModsFolderClick"/><Button Content="打开备份目录" Click="TrashFolderClick"/></WrapPanel><ListBox Grid.Row="2" x:Name="InstalledContent"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel><Border Grid.Column="1" Background="#EAF3F8" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5"><TextBlock Text="{Binding State}" Foreground="#7088C4" FontSize="11"/></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel Grid.Row="3" Margin="0,8,0,0"><Button Content="启用 / 禁用" Click="ToggleContentClick"/><Button Content="更新所选内容" Click="UpdateContentClick"/><Button Content="批量检查更新" Click="CheckAllUpdatesClick"/><Button Content="回退最近内容操作" Click="RestoreContentClick"/><Button Content="移至备份" Click="RemoveContentClick"/><TextBlock Text="更新支持由本启动器安装的内容" VerticalAlignment="Center" Style="{StaticResource Caption}"/></WrapPanel></Grid></TabItem>
    <TabItem Header="启动设置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="游戏与 Java" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,19"/><TextBlock Text="游戏根目录" Style="{StaticResource Caption}"/><TextBox x:Name="GameRoot"/><TextBlock Text="Java 可执行文件 · 留空自动管理" Style="{StaticResource Caption}"/><TextBox x:Name="JavaPath"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="最大内存 / MB" Style="{StaticResource Caption}"/><TextBox x:Name="Memory" Text="4096"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="游戏窗口 / 宽 × 高" Style="{StaticResource Caption}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="GameWidth" Text="1280"/><TextBox Grid.Column="2" x:Name="GameHeight" Text="720"/></Grid></StackPanel></Grid><Button Content="保存设置" Style="{StaticResource Primary}" Click="SaveClick" HorizontalAlignment="Left"/><Button Content="下载与网络设置" Click="NetworkClick" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="关于 MCUG Launcher" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="参考 PCL / HMCL / SJMCL 的使用习惯，独立设计与实现。非 Mojang / Microsoft 官方产品。" TextWrapping="Wrap" Foreground="#647782" Margin="0,10,0,0"/><Button Content="第三方许可与源码参考" Click="NoticesClick" HorizontalAlignment="Left" Margin="0,10,0,0"/><TextBlock Text="0.19.0 · 微软与 MUA 账号凭据使用 Windows 用户级加密保存，正版启动前验证和刷新。" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,9,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="运行日志"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="启动器与游戏实时输出（敏感字段已过滤）" Margin="0,0,0,10"/><TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0" Background="#F8FAFE"/><WrapPanel Grid.Row="2" Margin="0,8"><Button Content="刷新最近启动实例 latest.log" Click="ReadGameLogClick"/><Button Content="打开日志目录" Click="LogsFolderClick"/></WrapPanel><TextBox Grid.Row="3" x:Name="GameLogView" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0" Background="#F8FAFE" Text="点击刷新读取游戏仍在写入的日志，最多显示末尾 64 KB。"/></Grid></TabItem>
   <TabItem Header="任务与恢复"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="下载按加入顺序执行。暂停保留缓存，继续会校验并恢复；重启后自动恢复排队和意外中断的任务，已暂停任务保持暂停。" TextWrapping="Wrap" Margin="0,0,0,16" Foreground="#647782"/><ListBox Grid.Row="1" x:Name="TaskHistoryList"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#647782" Margin="0,8,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel Grid.Row="2"><Button Content="暂停" Click="PauseDownloadClick"/><Button Content="继续 / 失败重试" Click="ResumeDownloadClick"/><Button Content="取消下载" Click="CancelDownloadClick"/><Button Content="刷新任务记录" Click="RefreshOperationsClick"/><Button Content="定位实例与恢复说明" Click="LocateOperationClick"/></WrapPanel></Grid></TabItem></TabControl>
   <Grid x:Name="TaskStatusBar" Grid.Row="2" Height="57" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="4"/><RowDefinition Height="10"/></Grid.RowDefinitions><Button x:Name="CancelTaskButton" Content="取消任务" Click="CancelTaskClick" HorizontalAlignment="Right" Padding="10,5" Margin="0" IsEnabled="False"/><TextBlock Margin="0,0,100,0" x:Name="Status" Text="正在初始化…" FontSize="11" Foreground="#8F9BB2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><ProgressBar Grid.Row="1" x:Name="Progress" Height="3" Foreground="#6384E8" Background="#E6ECF8" BorderThickness="0"/></Grid>
  </Grid>
 </Grid>
</Window>












