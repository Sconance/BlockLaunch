{
  "dotnet.defaultSolution": "MCUGLauncher.sln",
  "dotnet.backgroundAnalysis.analyzerDiagnosticsScope": "openFiles",
  "dotnet.backgroundAnalysis.compilerDiagnosticsScope": "openFiles",
  "dotnet.diagnostics.reportInformationAsHint": true,
  "dotnet.server.useOmnisharp": false,
  "csharp.format.enable": false,
  "[csharp]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": null
  },
  "files.eol": "\n",
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/__pycache__": true,
    "artifacts": true,
    "work": true
  },
  "files.watcherExclude": {
    "**/bin/**": true,
    "**/obj/**": true,
    "**/__pycache__/**": true,
    "artifacts/**": true,
    "work/**": true
  }
}
