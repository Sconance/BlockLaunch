<Project>

  <!--
    版本号的唯一来源。发版时只改这里：

    - 程序集版本、文件版本、InformationalVersion 都由 McugVersion 派生；
    - 运行期通过 BlockLaunch.ProductInfo.Version 读取，User-Agent、诊断信息和关于页不再写死；
    - CHANGELOG.md、README.md 必须同步，由 python scripts/check-version.py 校验；
    - Release 标签使用 v<McugVersion>，附件必须从同一提交构建。

    规则见 docs/VERSIONING.md。
  -->
  <PropertyGroup>
    <McugVersion>0.22.2</McugVersion>
    <Version>$(McugVersion)</Version>
  </PropertyGroup>

  <!--
    VS Code（C# Dev Kit）的设计时构建不会设置 BuildingInsideVisualStudio，
    而 WPF 的目标只在该属性为 true 时执行 DesignTimeMarkupCompilation：

      Microsoft.WinFX.targets:
        <CoreCompileDependsOn Condition="'$(BuildingInsideVisualStudio)' == 'true'">
          DesignTimeMarkupCompilation; $(CoreCompileDependsOn)
        </CoreCompileDependsOn>

    缺少该标志时设计时编译拿不到 XAML 生成的 *.g.cs，x:Name 字段与
    InitializeComponent 全部缺失，语言服务器会报大量 CS1061 / CS0103。
    Visual Studio 自身以 BuildingInsideVisualStudio=true 运行，因此没有该问题。
    这里只在设计时构建中补上该标志，普通 build/publish 不受影响。
  -->
  <PropertyGroup Condition="'$(DesignTimeBuild)' == 'true'">
    <BuildingInsideVisualStudio>true</BuildingInsideVisualStudio>
  </PropertyGroup>
</Project>
