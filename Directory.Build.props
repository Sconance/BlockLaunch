<Project>
  <PropertyGroup>
    <McugVersion>0.22.3</McugVersion>
    <Version>$(McugVersion)</Version>
  </PropertyGroup>

  <!--
    VS Code（C# Dev Kit）的设计时构建不会设置 BuildingInsideVisualStudio，
    而 WPF 的 DesignTimeMarkupCompilation 只在该属性为 true 时挂入
    CoreCompileDependsOn。缺少该标志时 XAML 生成的 *.g.cs 不参与设计时编译，
    x:Name 字段与 InitializeComponent 全部缺失，语言服务器会报大量
    CS1061 / CS0103。VS 本身以该标志运行，所以没有此问题。
    仅在 DesignTimeBuild=true 时补上，普通 build/publish 不受影响。
  -->
  <PropertyGroup Condition="'$(DesignTimeBuild)' == 'true'">
    <BuildingInsideVisualStudio>true</BuildingInsideVisualStudio>
  </PropertyGroup>
</Project>
